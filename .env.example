# API keys & endpoints
#
# Groq — speech-to-text (POST /api/stt)
GROQ_API_KEY=gsk_your-groq-key
#
# Gemini — foreground interviewer (POST /api/interview/turn, /evaluate, /report, /interview/select)
GEMINI_API_KEY=your-gemini-key
# Optional model override. Default: gemini-3.5-flash-lite (cheapest available).
# gemini-2.5-flash / 2.5-flash-lite are retired for new projects.
GEMINI_MODEL=gemini-3.5-flash-lite
#
# Piper TTS runs in the browser (OPFS-cached) and is the primary engine.
# This proxy is only an optional fallback for browsers without OPFS.
# PIPER_TTS_URL=http://localhost:5000/api/tts
#
# Supabase — persistence only (the app itself is hosted on Vercel).
# Optional: without these the app uses Dexie/IndexedDB only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
#
# PeerJS broker
# Default: the free hosted cloud — https://peerjs.com/client/getting-started
# (client host "0.peerjs.com", port 443, path "/", key "peerjs").
#
# To use a self-hosted broker instead, start `npm run peer-server` and set:
#   NEXT_PUBLIC_PEERJS_HOST=localhost
#   NEXT_PUBLIC_PEERJS_PORT=9000
#   NEXT_PUBLIC_PEERJS_PATH=/peerjs
#   NEXT_PUBLIC_PEERJS_KEY=peerjs
