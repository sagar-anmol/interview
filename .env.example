# API keys & endpoints
#
# Groq — speech-to-text (POST /api/stt)
GROQ_API_KEY=gsk_your-groq-key
#
# Gemini — foreground interviewer (POST /api/interview/turn, /evaluate, /report, /interview/select)
GEMINI_API_KEY=your-gemini-key
#
# Piper TTS — local HTTP TTS service
# Expected: POST {PIPER_TTS_URL} with JSON body {text: string} -> audio/wav or raw PCM
PIPER_TTS_URL=http://localhost:5000/api/tts
#
# PeerJS broker
# Default: the free hosted cloud — https://peerjs.com/client/getting-started
# (client host "0.peerjs.com", port 443, path "/", key "peerjs").
#
# To use a self-hosted broker instead, start `npm run peer-server` and set:
#   NEXT_PUBLIC_PEERJS_HOST=localhost
#   NEXT_PUBLIC_PEERJS_PORT=9000
#   NEXT_PUBLIC_PEERJS_PATH=/peerjs
#   NEXT_PUBLIC_PEERJS_KEY=peerjs
